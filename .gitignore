# =============================================================================
# Terraform .gitignore
# =============================================================================

# Terraform working directory
.terraform/

# Terraform state files (state is stored in S3, never commit)
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Sensitive variable files (secrets should be in env vars or AWS Secrets Manager)
*.auto.tfvars
*.auto.tfvars.json
secret.tfvars
secrets.tfvars

# NOTE: terraform.tfvars in environments/ ARE committed intentionally
# They contain non-sensitive environment config (CIDRs, instance types, etc.)

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and local plans
.terraformrc
terraform.rc
*.tfplan

# Lock file (commit this — ensures consistent provider versions)
# !.terraform.lock.hcl

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
